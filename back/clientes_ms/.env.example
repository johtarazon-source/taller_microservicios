APP_ENV=local
APP_TIMEZONE=America/Bogota

# Base de datos propia de clientes_ms (se crea sola si no existe; ningun otro servicio la usa)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clientes_db
DB_USERNAME=root
DB_PASSWORD=

# Servicio que valida los tokens Bearer
AUTH_MS_URL=http://127.0.0.1:8001

# Servicio de reservas: clientes_ms le pide el historial y si el cliente tiene reservas (no accede a su base)
RESERVAS_MS_URL=http://127.0.0.1:8004

# Origenes permitidos para consumir la API desde el navegador, separados por coma.
CORS_ALLOWED_ORIGIN=http://localhost,http://localhost:8080,http://127.0.0.1:8080
