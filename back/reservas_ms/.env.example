APP_ENV=local
APP_TIMEZONE=America/Bogota

# Base de datos propia de reservas_ms (se crea sola si no existe; ningun otro servicio la usa)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reservas_db
DB_USERNAME=root
DB_PASSWORD=

# Servicio que valida los tokens Bearer
AUTH_MS_URL=http://127.0.0.1:8001

# Servicios de los que reservas_ms consulta clientes y vehiculos (no accede a sus bases)
CLIENTES_MS_URL=http://127.0.0.1:8003
VEHICULOS_MS_URL=http://127.0.0.1:8002

# Origenes permitidos para consumir la API desde el navegador, separados por coma.
CORS_ALLOWED_ORIGIN=http://localhost,http://localhost:8080,http://127.0.0.1:8080
