{
    "name": "taller/vehiculos-ms",
    "description": "Microservicio de vehiculos (alquiler de vehículos)",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "slim/slim": "4.*",
        "slim/psr7": "^1.8",
        "illuminate/database": "^9.52"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/global/Env.php",
            "app/global/database_config.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
