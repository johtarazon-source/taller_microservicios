APP_ENV=local
APP_TIMEZONE=America/Bogota

# Administrador del sistema. Si no se definen ADMIN_USER ni ADMIN_PASSWORD se usan las credenciales
# de demostración heredadas del monolito (admin / admin1234): cámbielas fuera de un entorno de pruebas.
# ADMIN_USER=admin
# ADMIN_PASSWORD="admin1234"

# Vigencia del token de sesión
APP_TOKEN_TTL_MINUTES=120

# Origenes permitidos para consumir la API desde el navegador, separados por coma.
CORS_ALLOWED_ORIGIN=http://localhost,http://localhost:8080,http://127.0.0.1:8080
