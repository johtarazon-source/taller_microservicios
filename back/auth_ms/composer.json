{
    "name": "taller/auth-ms",
    "description": "Microservicio de autenticación (alquiler de vehículos)",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "slim/slim": "4.*",
        "slim/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/global/Env.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
